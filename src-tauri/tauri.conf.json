{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Home Cleaner",
  "version": "0.1.0",
  "identifier": "com.raantss.homecleaner",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Home Cleaner",
        "width": 1280,
        "height": 860,
        "minWidth": 900,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["appimage", "deb"],
    "category": "Utility",
    "shortDescription": "Nettoyage du dossier home",
    "longDescription": "Scanne $HOME pour trouver doublons, dossiers obsolètes, gros fichiers et liens cassés. Toute suppression est validée manuellement.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
